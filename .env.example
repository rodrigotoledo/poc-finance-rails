# Copie para .env e preencha os valores
# NUNCA commite o .env — apenas o .env.example

# Rails
RAILS_MASTER_KEY=           # gerado automaticamente pelo make setup
RAILS_ENV=development

# Postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/credito_poc_development

# Redis
REDIS_URL=redis://redis:6379/0

# Segurança — gerado automaticamente pelo make setup
SECRET_KEY_BASE=
BCRYPT_COST=12

# BACEN / Compliance (para mocks locais)
BACEN_API_URL=https://api.bcb.gov.br
BACEN_API_KEY=mock_bacen_key_dev

# Comportamento na inicializacao (Docker dev)
FORCE_DB_CREATE=false
FORCE_DB_SEED=false
