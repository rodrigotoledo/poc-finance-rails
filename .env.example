# Copie para .env e preencha os valores
# NUNCA commite o .env — apenas o .env.example
#
# Postgres e Redis vêm de compose.infra.yml na raiz; os hostnames abaixo são os serviços Docker
# no mesmo projeto Compose (merge com compose.yml desta pasta). Fora do Docker, use
# localhost nas URLs e as portas publicadas (ex.: postgres em localhost:5432).

# Docker build (app / guard): use o MESMO usuário/grupo do seu macOS para o volume .:/app continuar editável no Cursor.
# No terminal: id -u   e   id -g   (ex.: 501 e 20)
USER_ID=1000
GROUP_ID=1000

# Rails
RAILS_MASTER_KEY=           # gerado automaticamente pelo make setup
RAILS_ENV=development

# Postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/credito_poc_development

# Redis
REDIS_URL=redis://redis:6379/0

# Segurança — gerado automaticamente pelo make setup
SECRET_KEY_BASE=
BCRYPT_COST=12

# BACEN / Compliance (para mocks locais)
BACEN_API_URL=https://api.bcb.gov.br
BACEN_API_KEY=mock_bacen_key_dev

# Comportamento na inicializacao (Docker dev)
FORCE_DB_CREATE=false
FORCE_DB_SEED=false
